<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_ara_dashboard">
        <field name="name">Ara Dashboard</field>
        <field name="sequence">25</field>
        <field name="category_id" ref="base.module_category_productivity"/>
    </record>

    <record id="group_ara_dashboard_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_ara_dashboard"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_ara_dashboard_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_ara_dashboard"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="implied_ids" eval="[(4, ref('group_ara_dashboard_user'))]"/>
    </record>

    <!-- Multi-Company Record Rules -->
    <record id="ara_dashboard_comp_rule" model="ir.rule">
        <field name="name">Ara Dashboard Multi-Company</field>
        <field name="model_id" ref="model_ara_dashboard"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="ara_dashboard_widget_comp_rule" model="ir.rule">
        <field name="name">Ara Dashboard Widget Multi-Company</field>
        <field name="model_id" ref="model_ara_dashboard_widget"/>
        <field name="domain_force">[('dashboard_id.company_id', 'in', company_ids)]</field>
    </record>
</odoo>
