    <record id="demo_widget_exec_revenue" model="ara.dashboard.widget">
        <field name="dashboard_id" ref="demo_ara_dashboard_executive"/>
        <field name="name">Total Confirmed Revenue</field>
        <field name="sequence">1</field>
        <field name="widget_type">kpi</field>
        <field name="col_span">4</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="date_field_id" ref="sale.field_sale_order__date_order"/>
        <field name="measure_field_id" ref="sale.field_sale_order__amount_total"/>
        <field name="aggregation_type">sum</field>
        <field name="domain">[('state', 'in', ['sale', 'done'])]</field>
        <field name="kpi_icon">fa-dollar-sign</field>
        <field name="color_accent">purple</field>
        <field name="trend_comparison">prev_period</field>
    </record>

