<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Client Action: Interactive Ara Dashboard -->
    <record id="action_ara_dashboard_client" model="ir.actions.client">
        <field name="name">Ara Dashboard</field>
        <field name="tag">ara_dashboard_main</field>
        <field name="target">main</field>
    </record>

    <!-- Action: Dashboard Records Configuration -->
    <record id="action_ara_dashboard_config_list" model="ir.actions.act_window">
        <field name="name">Dashboards</field>
        <field name="res_model">ara.dashboard</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Ara Business Dashboard!
            </p>
        </field>
    </record>

    <!-- Top Root Menu -->
    <menuitem id="menu_ara_dashboard_root"
              name="Ara Dashboard"
              web_icon="ara_dashboard,static/description/icon.png"
              sequence="5"/>

    <!-- Direct View Menu -->
    <menuitem id="menu_ara_dashboard_view"
              name="Dashboard Hub"
              parent="menu_ara_dashboard_root"
              action="action_ara_dashboard_client"
              sequence="10"/>

    <!-- Configuration Menu -->
    <menuitem id="menu_ara_dashboard_config"
              name="Configuration"
              parent="menu_ara_dashboard_root"
              groups="ara_dashboard.group_ara_dashboard_manager"
              sequence="90"/>

    <menuitem id="menu_ara_dashboard_config_dashboards"
              name="Dashboards"
              parent="menu_ara_dashboard_config"
              action="action_ara_dashboard_config_list"
              sequence="10"/>

    <menuitem id="menu_ara_dashboard_config_widgets"
              name="Widgets"
              parent="menu_ara_dashboard_config"
              action="action_ara_dashboard_widget_list"
              sequence="20"/>

    <menuitem id="menu_ara_dashboard_scheduled_reports"
              name="Scheduled Reports"
              parent="menu_ara_dashboard_root"
              action="action_ara_dashboard_report_schedule"
              sequence="20"/>
</odoo>
