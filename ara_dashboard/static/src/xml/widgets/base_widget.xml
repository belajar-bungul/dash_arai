<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="ara_dashboard.BaseWidget">
        <div t-attf-class="ara-card #{colClass} #{accentClass} #{props.isEditMode ? 'is-reorderable' : ''}"
             t-att-draggable="props.isEditMode ? 'true' : 'false'"
             t-on-dragstart="handleDragStart"
             t-on-dragover="handleDragOver"
             t-on-drop="handleDrop">
            <t t-if="props.isEditMode">
                <div class="ara-reorder-banner">
                    <i class="fa fa-arrows"/> <span>Drag to Reorder</span>
                </div>
            </t>
            <div class="ara-card-header">
                <div class="ara-card-title-group">
                    <span t-attf-class="ara-widget-type-badge type-#{props.widget.widget_type}">
                        <t t-if="props.widget.widget_type === 'kpi'"><i class="fa fa-bolt"/></t>
                        <t t-elif="props.widget.widget_type === 'chart'"><i class="fa fa-bar-chart"/></t>
                        <t t-elif="props.widget.widget_type === 'table'"><i class="fa fa-table"/></t>
                        <t t-elif="props.widget.widget_type === 'progress'"><i class="fa fa-sliders"/></t>
                        <t t-elif="props.widget.widget_type === 'funnel'"><i class="fa fa-filter"/></t>
                        <t t-elif="props.widget.widget_type === 'flower'"><i class="fa fa-pie-chart"/></t>
                        <t t-elif="props.widget.widget_type === 'gauge'"><i class="fa fa-tachometer"/></t>
                        <t t-elif="props.widget.widget_type === 'heatmap'"><i class="fa fa-th"/></t>
                        <t t-elif="props.widget.widget_type === 'treemap'"><i class="fa fa-th-large"/></t>
                        <t t-elif="props.widget.widget_type === 'radar'"><i class="fa fa-compass"/></t>
                        <t t-elif="props.widget.widget_type === 'waterfall'"><i class="fa fa-signal"/></t>
                        <t t-elif="props.widget.widget_type === 'sankey'"><i class="fa fa-random"/></t>
                        <t t-elif="props.widget.widget_type === 'scatter'"><i class="fa fa-braille"/></t>
                        <t t-elif="props.widget.widget_type === 'geo'"><i class="fa fa-globe"/></t>
                        <t t-else=""><i class="fa fa-cube"/></t>
                    </span>
                    <h4 class="ara-card-title">
                        <t t-esc="props.widget.name"/>
                    </h4>
                </div>
                <div class="ara-card-actions">
                    <t t-if="props.isEditMode">
                        <button class="ara-card-action-btn edit-btn" title="Edit Widget" t-on-click="handleEdit">
                            <i class="fa fa-pencil"/>
                        </button>
                        <button class="ara-card-action-btn copy-btn" title="Duplicate Widget" t-on-click="handleDuplicate">
                            <i class="fa fa-clone"/>
                        </button>
                        <button class="ara-card-action-btn delete-btn" title="Delete Widget" t-on-click="handleDelete">
                            <i class="fa fa-trash-o"/>
                        </button>
                    </t>
                    <button class="ara-card-action-btn" title="Inspect Data" t-on-click="onWidgetClick">
                        <i class="fa fa-external-link"/>
                    </button>
                </div>
            </div>
            <div class="ara-card-body">
                <t t-if="hasError">
                    <div class="ara-state-msg is-error">
                        <i class="fa fa-exclamation-triangle"/>
                        <p><t t-esc="errorMessage"/></p>
                    </div>
                </t>
                <t t-else="">
                    <t t-slot="default"/>
                </t>
            </div>
        </div>
    </t>
</templates>
