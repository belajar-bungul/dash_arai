<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="ara_dashboard.KPIWidget">
        <div class="ara-kpi-content" t-on-click="onClick">
            <div class="ara-kpi-main">
                <div class="ara-kpi-value">
                    <t t-esc="data.formatted_value || '0'"/>
                </div>
                <div t-attf-class="ara-kpi-icon-wrap #{accentClass}">
                    <i t-attf-class="fa #{data.icon || 'fa-chart-line'}"/>
                </div>
            </div>
            <div class="ara-kpi-footer">
                <t t-if="data.comparison_label">
                    <span t-attf-class="ara-trend-badge #{trendClass}">
                        <i t-attf-class="fa #{trendIcon}"/>
                        <t t-esc="data.trend_pct || '0'"/>%
                    </span>
                    <span class="ara-comparison-label">
                        <t t-esc="data.comparison_label"/>
                    </span>
                </t>
            </div>
        </div>
    </t>
</templates>
